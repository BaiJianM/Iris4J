<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.iris</groupId>
    <artifactId>iris-lite</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>iris-lite</name>
    <description>Redis Iris-like capability layer for agents (Java)</description>

    <modules>
        <module>shared</module>
        <module>context</module>
        <module>application</module>
        <module>infrastructure</module>
        <module>cdc</module>
        <module>memory</module>
        <module>cache</module>
        <module>web</module>
        <module>demo</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- 各依赖版本统一由 dependencyManagement 与 Boot/Spring AI BOM 锁定 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-context</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-cdc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.iris</groupId>
                <artifactId>iris-lite-demo</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <!-- 可执行 JAR 只在 boot 模块（web / demo）repackage -->
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
