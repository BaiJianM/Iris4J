<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iris</groupId>
        <artifactId>iris4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>iris4j-web</artifactId>
    <name>iris4j-web</name>
    <description>中间件 HTTP 面 + 启动模块：REST 数据/运维端点 + MCP 服务面 + 安全，产物为不含演示的中间件 fat jar</description>

    <dependencies>
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>iris4j-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>iris4j-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>iris4j-cache</artifactId>
        </dependency>
        <!-- runtime 传递给 boot 模块（api/demo）打包；本模块代码不直接引用 -->
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>iris4j-cdc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>iris4j-infrastructure</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标输出：/actuator/prometheus；版本由 Boot BOM 管理 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- MCP Server（Streamable-HTTP，端点 /mcp），版本由 spring-ai-bom 管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- 动态工具注册器序列化查询结果用；Boot 4 的 starter-web 不再传递提供 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.iris4j.api.Iris4JApplication</mainClass>
                    <!-- fat jar 挂 -exec 分类器，主产物保持普通 JAR：
                         demo 模块依赖本模块时必须解析到普通 JAR，
                         fat jar 的类藏在 BOOT-INF/classes 里无法作为依赖使用 -->
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
