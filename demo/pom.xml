<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iris</groupId>
        <artifactId>redis-iris-java</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>redis-iris-java-demo</artifactId>
    <name>redis-iris-java-demo</name>
    <description>Agent 演示模块（boot）：聊天循环 + SSE + 配方自进化 + console 前端，独立于中间件部署体系</description>

    <dependencies>
        <!-- 中间件 HTTP 面（含 REST/MCP 端点与安全，console 页面消费）+ 传递业务模块 -->
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>redis-iris-java-web</artifactId>
        </dependency>
        <!-- 演示链路的端口实现（AgentChatClient/McpToolPort/QueryPathAdvisor/RecipeDraftStore impl）
             直接引用 infrastructure 内部类（如 RedisAdapter），需要编译期可见 -->
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>redis-iris-java-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.iris.lite.java.demo.DemoApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
