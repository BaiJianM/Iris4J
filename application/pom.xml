<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iris</groupId>
        <artifactId>iris4j</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>iris4j-application</artifactId>
    <name>iris4j-application</name>
    <description>用例编排和统一应用服务（不包含 Redis 命令和 MCP 传输细节）</description>

    <dependencies>
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>iris4j-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>iris4j-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iris</groupId>
            <artifactId>iris4j-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- @PreDestroy（MemoryExtractionService 停机时优雅关闭抽取 worker） -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Agent 工具分发器把服务结果序列化为 JSON 文本喂回 LLM；
             版本由 Spring Boot BOM 管理（api/infrastructure 已在用） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
